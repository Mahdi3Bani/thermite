# Thermite control service image: dashboard, API, MCP, command queues.
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
RUN npm ci --no-fund --no-audit
COPY src ./src
RUN npm run build && npm prune --omit=dev --no-fund --no-audit

FROM ${NODE_IMAGE}
RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/thermite
COPY --from=build /src/package.json ./
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/dist ./dist
COPY containers/thermite /usr/local/bin/thermite
# Mount points owned by the runtime user, so new named volumes inherit the ownership.
RUN mkdir -p /var/lib/thermite-control /keys && chown 10001:10001 /var/lib/thermite-control /keys
ENV NODE_OPTIONS=--disable-warning=ExperimentalWarning
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "/opt/thermite/dist/control/main.js"]
