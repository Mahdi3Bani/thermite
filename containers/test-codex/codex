#!/usr/bin/env node
// Test only (scripts/codex-acceptance.mjs): a stand-in for the Codex CLI's headless mode
// (`codex exec --json`, the prompt on stdin). It prints the JSON events Codex prints (the thread,
// its items, the turn's tokens) and does what each of Thermite's calls asks: the model check's
// echo, the planner's JSON plan, a trial's change and its submission with thermite-trial, or the
// auditor's answer in the supervisor (what its configuration and its call gave it, as reasons). It
// sends one request to the provider its configuration names, as Codex would, to show the route
// goes through the harness's proxy with the run's own credential. It reports what it was given
// (its user, its home, the flags, the proxy's answer), never a credential itself. It refuses to
// run without THERMITE_FAKE_CODEX=1 or its mounted folder, so it can't stand in by mistake.
const { execSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");
if (process.env.THERMITE_FAKE_CODEX !== "1" && !fs.existsSync("/opt/fake-codex/enabled")) {
  process.stderr.write("test-codex: not enabled\n");
  process.exit(2);
}
const args = process.argv.slice(2);
const val = (f) => (args.includes(f) ? args[args.indexOf(f) + 1] : undefined);
if (args[0] !== "exec" || args.at(-1) !== "-") {
  process.stderr.write(`test-codex: expected exec ... -, got ${args.join(" ")}\n`);
  process.exit(2);
}
const prompt = fs.readFileSync(0, "utf8");
const resumed = val("resume");
const thread = resumed ?? `0199a213-0000-7000-8000-${String(process.pid).padStart(12, "0")}`;
const out = (e) => process.stdout.write(`${JSON.stringify(e)}\n`);
// Its configuration, as Codex reads it: $CODEX_HOME/config.toml (one provider, the proxy).
const home = process.env.CODEX_HOME ?? "";
const config = fs.existsSync(path.join(home, "config.toml"))
  ? fs.readFileSync(path.join(home, "config.toml"), "utf8")
  : "";
const setting = (k) => new RegExp(`^${k} = "([^"]*)"$`, "m").exec(config)?.[1];
const baseUrl = setting("base_url");
const envKey = setting("env_key");
const credential = envKey ? (process.env[envKey] ?? "") : "";
let n = 0;
const item = (type, fields) => ({ id: `item_${n++}`, type, ...fields });
const shell = (command) => {
  const started = item("command_execution", {
    command,
    aggregated_output: "",
    exit_code: null,
    status: "in_progress",
  });
  out({ type: "item.started", item: started });
  let output;
  let code = 0;
  try {
    output = execSync(command, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"], shell: "/bin/sh" });
  } catch (e) {
    output = `${e.stdout ?? ""}${e.stderr ?? ""}`;
    code = e.status ?? 1;
  }
  out({
    type: "item.completed",
    item: { ...started, aggregated_output: output, exit_code: code, status: code ? "failed" : "completed" },
  });
  return output;
};
const say = (text) => out({ type: "item.completed", item: item("agent_message", { text }) });

(async () => {
  // One Responses call to the configured provider, with the run's credential, as Codex makes it.
  let proxied = "none";
  if (baseUrl && credential)
    try {
      const r = await fetch(`${baseUrl}/responses`, {
        method: "POST",
        headers: { "content-type": "application/json", authorization: `Bearer ${credential}` },
        body: JSON.stringify({ model: val("--model"), input: "ping", stream: true }),
      });
      await r.text();
      proxied = String(r.status);
    } catch (e) {
      proxied = `error:${String(e?.cause?.code ?? e?.message ?? e).replace(/\s+/g, "-")}`;
    }
  const facts = [
    `uid=${process.getuid()}`,
    `home=${home && config.includes('model_provider = "thermite"') ? "own" : "missing"}`,
    `proxy_url=${baseUrl?.endsWith("/v1/model-proxy") ? "harness" : (baseUrl ?? "none")}`,
    `auth=${credential.startsWith("trial.") ? "trial" : credential.startsWith("proxy.") ? "proxy" : "missing"}`,
    `proxied=${proxied}`,
    `bypass=${args.includes("--dangerously-bypass-approvals-and-sandbox")}`,
    `ignore_rules=${args.includes("--ignore-rules")}`,
    `resumed=${resumed ? "yes" : "no"}`,
    `model=${val("--model")}`,
  ].join(" ");
  out({ type: "thread.started", thread_id: thread });
  out({ type: "turn.started" });
  out({ type: "item.completed", item: item("reasoning", { text: "**Reading the task**" }) });
  const word = /run exactly this command: echo (thermite-[a-z0-9]+)/.exec(prompt)?.[1];
  if (/You audit a candidate change/.test(prompt)) {
    // The auditor, run by the supervisor (goal 073): what its configuration and its call gave
    // it, as its reasons. Its tools are the configuration's; it runs no command of its own.
    const off = (f) => new RegExp(`^${f} = false$`, "m").test(config);
    const advisor = [
      `sandbox=${setting("sandbox_mode") ?? "none"}`,
      `approvals=${setting("approval_policy") ?? "none"}`,
      `shell_off=${off("shell_tool") && off("unified_exec")}`,
      `advisor_proxy=${/^http:\/\/127\.0\.0\.1:\d+\/v1\/model-proxy$/.test(baseUrl ?? "") ? "supervisor" : (baseUrl ?? "none")}`,
      `ephemeral=${args.includes("--ephemeral")}`,
      `bypass=${args.includes("--dangerously-bypass-approvals-and-sandbox")}`,
      `own_folder=${/thermite-advisor-/.test(process.cwd()) && fs.realpathSync(process.env.HOME ?? "/") === process.cwd()}`,
      `mcp=${[...config.matchAll(/^\[mcp_servers\."([^"]+)"\]$/gm)].map((m) => m[1]).join(",") || "none"}`,
    ].join(" ");
    say(
      JSON.stringify({
        decision: "clear",
        reasons: `audited by the Codex stand-in (${advisor} ${facts})`,
        citations: ["diff"],
      }),
    );
  } else if (word) {
    say(shell(`echo ${word}`).trim());
  } else if (/The campaign, as JSON:/.test(prompt)) {
    const ctx = JSON.parse(prompt.slice(prompt.indexOf("The campaign, as JSON:") + "The campaign, as JSON:".length));
    say(
      JSON.stringify({
        new_families: [{ id: "cx-tidy", description: "Small tidy-ups proposed by the Codex stand-in." }],
        assignments: ctx.lanes.map((lane) => ({ lane, family: "cx-tidy", focus: "tidy the kernel", parent: "champion" })),
        notes: `planned by the Codex stand-in (${facts})`,
      }),
    );
  } else if (/thermite-trial submit/.test(prompt)) {
    shell(
      `printf '\\n/* tidied by codex */\\n' >> src/kernel/matmul.c && thermite-trial submit --hypothesis 'codex harness: a tidied kernel (${facts})'`,
    );
    say("Submitted.");
  } else {
    say("done");
  }
  out({
    type: "turn.completed",
    usage: {
      input_tokens: 1200 * n,
      cached_input_tokens: 600 * n,
      cache_write_input_tokens: 0,
      output_tokens: 40 * n,
      reasoning_output_tokens: 10 * n,
    },
  });
})();
