#!/bin/sh
# The one-container rig image's entry point (containers/rig/Containerfile). A host such as RunPod
# puts its own variables in the container's environment: RUNPOD_*, its API key and the pod's ID
# among them. They end here, before tini and the broker start, so no process of the rig has
# them, PID 1 included. The pod's ID, which the supervisor needs, goes on as THERMITE_POD_ID.
# Then it runs its arguments (tini, then the broker).
set -eu
if [ -n "${RUNPOD_POD_ID:-}" ] && [ -z "${THERMITE_POD_ID:-}" ]; then
  THERMITE_POD_ID=$RUNPOD_POD_ID
  export THERMITE_POD_ID
fi
for name in $(env | sed -n 's/^\(RUNPOD_[A-Za-z0-9_]*\)=.*/\1/p'); do
  unset "$name"
done
exec "$@"
