# Thermite supervisor image: reporting and command relay, git operations, teacher runtimes.
ARG NODE_IMAGE=docker.io/library/node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392

FROM ${NODE_IMAGE} AS build
WORKDIR /src
COPY package.json package-lock.json tsconfig.json tsconfig.build.json ./
RUN npm ci --no-fund --no-audit
COPY src ./src
RUN npm run build && npm prune --omit=dev --no-fund --no-audit

# Claude Code, for advisors on a Claude subscription (only Anthropic's own program may use one):
# downloaded when the image is built, and only when CLAUDE_CODE_VERSION names a version (off by
# default: it is not open source). As in the harness image.
FROM ${NODE_IMAGE} AS claude
ARG CLAUDE_CODE_VERSION=
ARG TARGETARCH
RUN mkdir -p /out \
 && if [ -n "$CLAUDE_CODE_VERSION" ]; then \
      cd /tmp \
      && npm pack --silent "@anthropic-ai/claude-code-linux-$([ "$TARGETARCH" = arm64 ] && echo arm64 || echo x64)@${CLAUDE_CODE_VERSION}" \
      && tar -xzf anthropic-ai-claude-code-linux-*.tgz \
      && bin="$(find package -maxdepth 2 -type f -name claude | head -n 1)" \
      && test -n "$bin" \
      && install -m 0755 "$bin" /out/claude \
      && /out/claude --version \
      && rm -rf /tmp/*; \
    fi

FROM ${NODE_IMAGE}
# python3: for an operator's staging scripts, which put models and repo bundles into the inbox
# before the supervisor starts (they run in this container).
# bubblewrap: an advisor on a Claude subscription runs Claude Code with
# CLAUDE_CODE_SUBPROCESS_ENV_SCRUB, and Claude Code then will not start without it, although an
# advisor runs no commands. It uses unprivileged user namespaces, not a setuid bit.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git openssh-client tini ca-certificates python3 \
      bubblewrap \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/thermite
COPY --from=build /src/package.json ./
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/dist ./dist
COPY containers/thermite /usr/local/bin/thermite
# Claude Code, when the build asked for it (CLAUDE_CODE_VERSION); otherwise this copies nothing.
COPY --from=claude /out/ /usr/local/bin/
# The runtime user needs a passwd entry: ssh (git over SSH) refuses a uid without one, and finds
# ~/.ssh from the entry's home, not from $HOME.
RUN groupadd -g 10001 supervisor \
 && useradd -u 10001 -g 10001 -M -d /var/lib/thermite-supervisor/home -s /usr/sbin/nologin supervisor
# Mount points owned by the runtime user, so new named volumes inherit the ownership.
RUN mkdir -p /var/lib/thermite-supervisor/home /results /outbox \
 && chown 10001:10001 /var/lib/thermite-supervisor /var/lib/thermite-supervisor/home /results \
 && chown 10010:10001 /outbox && chmod 2750 /outbox
ENV NODE_OPTIONS=--disable-warning=ExperimentalWarning
# The source commit the image is built from (empty: not given). The supervisor sends it with
# Thermite's version from package.json on its calls to control, which compares them with its own.
ARG THERMITE_COMMIT=
ENV THERMITE_COMMIT=${THERMITE_COMMIT}
USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "/opt/thermite/dist/supervisor/main.js"]
