{
  "schema_version": 1,
  "name": "smoke-cpu",
  "target": "cpu",
  "build": {
    "copy": [
      "bench"
    ],
    "command": [
      "sh",
      ".kit/bench/build.sh"
    ],
    "outputs": [
      "out/bench"
    ],
    "timeout_s": 120,
    "rss_mib": 1024,
    "disk_mib": 256
  },
  "cells": {
    "small": {
      "n": 128,
      "reps": 240,
      "seed": 11,
      "work": 1006632960
    },
    "large": {
      "n": 256,
      "reps": 40,
      "seed": 23,
      "work": 1342177280
    },
    "held": {
      "n": 192,
      "reps": 60,
      "seed": 37,
      "work": 849346560
    }
  },
  "run": {
    "command": [
      "{build:out/bench}",
      "{params}",
      "{out}"
    ],
    "timeout_s": 60,
    "rss_mib": 256,
    "disk_mib": 32
  },
  "metrics": {
    "flops_per_s": {
      "unit": "FLOP/s",
      "work": "work"
    }
  },
  "check": {
    "command": [
      "node",
      "{kit:check.mjs}",
      "{params_json}",
      "{out}"
    ],
    "timeout_s": 60
  }
}
