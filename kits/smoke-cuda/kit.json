{
  "schema_version": 1,
  "name": "smoke-cuda",
  "target": "cuda-gpu",
  "build": {
    "copy": [
      "bench"
    ],
    "command": [
      "sh",
      ".kit/bench/build.sh"
    ],
    "outputs": [
      "out/bench"
    ],
    "timeout_s": 300,
    "rss_mib": 2048,
    "disk_mib": 512
  },
  "cells": {
    "small": {
      "n": 512,
      "reps": 200,
      "seed": 11,
      "work": 53687091200
    },
    "large": {
      "n": 1024,
      "reps": 30,
      "seed": 23,
      "work": 64424509440
    },
    "held": {
      "n": 768,
      "reps": 60,
      "seed": 37,
      "work": 54358179840
    }
  },
  "run": {
    "command": [
      "{build:out/bench}",
      "{params}",
      "{out}"
    ],
    "timeout_s": 120,
    "rss_mib": 2048,
    "disk_mib": 64
  },
  "metrics": {
    "flops_per_s": {
      "unit": "FLOP/s",
      "work": "work"
    }
  },
  "check": {
    "command": [
      "node",
      "{kit:check.mjs}",
      "{params_json}",
      "{out}"
    ],
    "timeout_s": 300
  }
}
