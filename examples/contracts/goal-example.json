{
  "schema_version": 1,
  "campaign": "goal-example",
  "version": 1,
  "title": "Example goal campaign: support a new data type end to end",
  "mode": "goal",
  "project": { "repo": "my-project" },
  "target": { "type": "cpu", "class": "generic-cpu" },
  "lanes": { "count": 2, "trials_per_epoch": 2 },
  "editable_paths": ["src/**", "tests/**"],
  "goals": [
    {
      "id": "builds",
      "description": "the project builds with the new type",
      "priority": 1,
      "verify": { "type": "code", "verifier": "builds" }
    },
    {
      "id": "correct",
      "description": "results match the reference on every golden input",
      "priority": 2,
      "verify": { "type": "code", "verifier": "goldens" }
    },
    {
      "id": "fast",
      "description": "throughput on the large input is at least 150 million items per second",
      "priority": 3,
      "verify": {
        "type": "metric_threshold",
        "metric": "items_per_s",
        "op": ">=",
        "value": 150000000,
        "cells": ["large"]
      }
    },
    {
      "id": "readable",
      "description": "the change is clear enough to maintain",
      "required": false,
      "verify": { "type": "review", "criteria": ["clear names", "no dead code"] }
    }
  ],
  "deliverable": "a commit that meets every required goal",
  "insufficient": ["special-casing the golden inputs"],
  "infeasibility": { "allowed": true, "min_refuted_approaches": 3 }
}
